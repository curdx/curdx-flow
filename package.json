{
  "name": "@curdx/flow",
  "version": "7.1.14",
  "description": "Interactive installer for Claude Code plugins and MCP servers",
  "type": "module",
  "bin": "./dist/index.mjs",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsup",
    "build:hooks": "node scripts/build-hooks.mjs",
    "check:hooks-fresh": "node scripts/check-hooks-fresh.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "dev": "tsup --watch",
    "test:hooks": "npm run build:hooks && vitest run tests/hooks --passWithNoTests",
    "test:analyze": "vitest run tests/analyze",
    "test:runner": "vitest run tests/runner",
    "start": "node ./dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check-versions && npm run check:hooks-fresh && npm run build && npm run check:bundle && npm run test:hooks && npm run test:analyze && npm run test:runner && node scripts/check-verification-blocks.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "prepublishOnly": "node scripts/check-versions.mjs && npm run typecheck && npm run check:hooks-fresh && npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "installer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curdx/curdx-flow.git"
  },
  "bugs": {
    "url": "https://github.com/curdx/curdx-flow/issues"
  },
  "homepage": "https://github.com/curdx/curdx-flow#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "citty": "^0.1.6",
    "picocolors": "^1.1.0",
    "tinyexec": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
