{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow",
  "title": "curdx-flow Specification Schema",
  "description": "Schema for curdx-flow state files and spec document frontmatter",

  "properties": {
    "verificationBlocks": {
      "type": "object",
      "description": "Per-phase verification blocks proving a verify command was executed against current source. Iron-law gate (Stop/TaskCompleted hooks read this). One block per workflow phase; missing block for current phase blocks the hook with exit 2.",
      "additionalProperties": false,
      "properties": {
        "research": { "$ref": "#/$defs/verificationBlock" },
        "requirements": { "$ref": "#/$defs/verificationBlock" },
        "design": { "$ref": "#/$defs/verificationBlock" },
        "tasks": { "$ref": "#/$defs/verificationBlock" },
        "execution": { "$ref": "#/$defs/verificationBlock" }
      }
    }
  },

  "$defs": {
    "verificationBlock": {
      "type": "object",
      "description": "Machine-readable proof that a verify command ran against the current source state",
      "required": ["command", "exitCode", "timestamp", "srcMtime"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Exact verify command that was executed (e.g., 'npm run verify')"
        },
        "exitCode": {
          "type": "integer",
          "description": "Process exit code from the verify command (0 = pass, non-zero = fail)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp when verify command completed"
        },
        "srcMtime": {
          "type": "number",
          "minimum": 0,
          "description": "Max mtime (epoch ms) of relevant source tree at verify time; used for stale-detection"
        },
        "description": {
          "type": "string",
          "description": "Optional human-readable summary of what was verified"
        },
        "failedReason": {
          "type": "string",
          "description": "Optional failure detail when exitCode is non-zero"
        },
        "reviews": {
          "type": "object",
          "description": "Two-stage review verdicts (spec-two-stage-review D3). Keyed-object shape isomorphic to the parent verificationBlocks map. Both sub-fields optional for backwards-compat with pre-two-stage-review states.",
          "additionalProperties": false,
          "properties": {
            "specCompliance": { "$ref": "#/$defs/reviewVerdict" },
            "codeQuality": { "$ref": "#/$defs/reviewVerdict" }
          }
        }
      }
    },

    "reviewVerdict": {
      "type": "object",
      "description": "Reviewer verdict emitted at phase boundaries by spec-compliance / code-quality reviewers. 'advisory' surfaces findings without blocking (used by code-quality in QuickMode bypass per FR-M2).",
      "required": ["verdict", "findings", "reviewerId", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "advisory"],
          "description": "Reviewer outcome. 'pass' = no blocking issues; 'fail' = hard block; 'advisory' = surface findings, do not block"
        },
        "findings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Reviewer notes (one per concern). Empty array allowed on pass; fail/advisory should populate at least one entry"
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1,
          "description": "Agent identifier (e.g. 'spec-reviewer', 'code-quality-reviewer'). Used by drift tests to confirm domain ownership"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp when verdict was recorded"
        }
      }
    }
  },

  "definitions": {
    "autoPolicy": {
      "type": "object",
      "description": "Deterministic execution policy selected before expensive model work. Drives task sizing, review cadence, subagent usage, verification strictness, and Stop-hook continuation length.",
      "required": ["version", "mode", "size", "risk", "executionMode", "taskGranularity", "taskTargetRange", "reviewCadence", "verificationLevel", "subagentPolicy", "stopHookPolicy"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1,
          "description": "AutoPolicy schema version"
        },
        "mode": {
          "type": "string",
          "enum": ["auto", "fast", "deep"],
          "description": "User override mode parsed from --mode; auto is default"
        },
        "size": {
          "type": "string",
          "enum": ["XS", "S", "M", "L", "XL"],
          "description": "Execution size selected by deterministic classifier"
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Blast-radius risk selected by deterministic classifier"
        },
        "executionMode": {
          "type": "string",
          "enum": ["direct", "spec-lite", "standard", "deep-spec", "epic-triage"],
          "description": "Workflow strength selected for this spec"
        },
        "taskGranularity": {
          "type": "string",
          "enum": ["none", "coarse", "standard", "fine"],
          "description": "Task sizing policy; none means direct work without tasks.md"
        },
        "taskTargetRange": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "description": "Target number of vertical-slice tasks for a single spec"
        },
        "reviewCadence": {
          "type": "string",
          "enum": ["minimal", "final", "periodic", "strict"],
          "description": "How often independent review is required"
        },
        "verificationLevel": {
          "type": "string",
          "enum": ["targeted", "standard", "strict"],
          "description": "Verification strictness for task and phase exits"
        },
        "subagentPolicy": {
          "type": "string",
          "enum": ["none", "on-demand", "per-slice"],
          "description": "When implementation/review subagents should be used"
        },
        "stopHookPolicy": {
          "type": "string",
          "enum": ["disabled", "short-continuation", "full-loop"],
          "description": "How much continuation context the Stop hook may inject"
        },
        "maxGlobalIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Policy-selected global loop cap"
        },
        "maxTaskIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Policy-selected per-task retry cap"
        },
        "shouldSplitSpec": {
          "type": "boolean",
          "description": "True when the request should be decomposed into an epic or multiple specs"
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable classifier reasons for auditability"
        }
      }
    },

    "state": {
      "type": "object",
      "description": "Runtime state for spec execution loop. v2 state is intentionally allowed to break legacy state; rebuild stale state instead of silently migrating malformed files.",
      "required": ["version", "source", "name", "basePath", "phase"],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2,
          "description": "curdx-flow state schema version"
        },
        "source": {
          "type": "string",
          "enum": ["spec", "plan", "direct"],
          "description": "Origin of tasks: spec (full workflow), plan (skip to tasks), direct (manual tasks.md)"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Spec name in kebab-case"
        },
        "basePath": {
          "type": "string",
          "description": "Path to spec directory (e.g., ./specs/my-feature)"
        },
        "identity": {
          "type": "object",
          "description": "Stable v2 identity block used by workflow-snapshot and phase skills",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "basePath": { "type": "string" },
            "goal": { "type": "string" }
          }
        },
        "phase": {
          "type": "string",
          "enum": ["research", "requirements", "design", "tasks", "execution"],
          "description": "Current workflow phase"
        },
        "taskIndex": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Current task index (0-based)"
        },
        "totalTasks": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Total number of tasks in tasks.md"
        },
        "taskIteration": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Current iteration for this task (resets per task)"
        },
        "maxTaskIterations": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Max retries per task before failure"
        },
        "globalIteration": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Total loop iterations across all tasks"
        },
        "maxGlobalIterations": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Safety cap on total iterations. Tightened to 30 in v7.1.7 (~1hr unattended). Use --max-global-iterations 100 to opt back to legacy."
        },
        "relatedSpecs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "relevance": { "enum": ["high", "medium", "low"] },
              "reason": { "type": "string" },
              "mayNeedUpdate": { "type": "boolean" }
            },
            "required": ["name", "relevance", "reason"]
          },
          "description": "Existing specs related to this one"
        },
        "parallelGroup": {
          "type": "object",
          "description": "Current parallel task group being executed",
          "properties": {
            "startIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "First task index in current parallel group"
            },
            "endIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "Last task index in current parallel group"
            },
            "taskIndices": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "All task indices in the parallel group"
            }
          },
          "required": ["startIndex", "endIndex", "taskIndices"]
        },
        "taskResults": {
          "type": "object",
          "description": "Per-task execution results for parallel batch",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["pending", "success", "failed"],
                "description": "Task execution status"
              },
              "error": {
                "type": "string",
                "description": "Error message if task failed"
              }
            },
            "required": ["status"]
          }
        },
        "recoveryMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable iterative failure recovery"
        },
        "maxFixTasksPerOriginal": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Max fix tasks allowed per original task"
        },
        "fixTaskMap": {
          "type": "object",
          "description": "Tracks fix attempts per original task",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "attempts": { "type": "integer", "minimum": 0 },
              "fixTaskIds": { "type": "array", "items": { "type": "string" } },
              "lastError": { "type": "string" }
            },
            "required": ["attempts", "fixTaskIds"]
          }
        },
        "modificationMap": {
          "type": "object",
          "description": "Tracks modification requests per original task",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "modifications": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string", "enum": ["SPLIT_TASK", "ADD_PREREQUISITE", "ADD_FOLLOWUP"] },
                    "reason": { "type": "string" }
                  },
                  "required": ["id", "type"]
                }
              }
            },
            "required": ["count", "modifications"]
          }
        },
        "maxModificationsPerTask": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Max modification requests allowed per original task"
        },
        "maxModificationDepth": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Max nesting depth for modification task IDs"
        },
        "epicName": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Parent epic name if this spec belongs to an epic"
        },
        "granularity": {
          "type": "string",
          "enum": ["auto", "fine", "standard", "coarse"],
          "description": "Task sizing override. AutoPolicy is authoritative when present; legacy fine/coarse states remain valid."
        },
        "autoPolicy": {
          "$ref": "#/definitions/autoPolicy",
          "description": "Policy selected by hooks/scripts/lib/auto-policy.mjs and persisted for all later phases"
        },
        "route": {
          "type": "object",
          "description": "Route decision returned by curdx-flow route at spec creation time",
          "additionalProperties": true
        },
        "coverage": {
          "type": "object",
          "description": "Source coverage audit state generated by task planning and reviewers",
          "additionalProperties": true
        },
        "projectTopology": {
          "type": "object",
          "description": "Compact topology facts returned by hooks/scripts/lib/smart-route.mjs for multi-root and empty-workspace project routing",
          "additionalProperties": true
        },
        "intent": {
          "type": "object",
          "description": "Adaptive start intent facts returned by curdx-flow route: workspace state, intent kind, clarity, stack/artifact signals, delivery expectation, and missing facts",
          "additionalProperties": true
        },
        "recommendedCapabilities": {
          "type": "array",
          "description": "Stage-aware capability hints returned by smart-route. Plugin wheels are provided by plugin dependencies, context7/sequential-thinking are external MCPs configured outside this plugin, and workflow/policy hints need no installation.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "claude-mem",
                  "context7",
                  "sequential-thinking",
                  "chrome-devtools-mcp",
                  "ui-ux-pro-max",
                  "pua",
                  "docs-query",
                  "browser-verification",
                  "tdd-cycle",
                  "security-review",
                  "stack-specific-verification",
                  "context-budget"
                ]
              },
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["plugin", "mcp", "workflow", "policy"] },
              "invocation": { "type": "string" },
              "phase": {
                "type": "string",
                "enum": ["before-coding", "planning", "implementation", "verification", "recovery"]
              },
              "category": {
                "type": "string",
                "enum": ["docs", "verification", "tdd", "security", "context", "recovery"]
              },
              "availability": {
                "type": "string",
                "enum": ["plugin-dependency", "external-expected", "core-required", "known-available", "check-if-installed"]
              },
              "availabilityState": {
                "type": "string",
                "enum": ["available", "expected", "missing", "workflow"]
              },
              "ownedBy": {
                "type": "string",
                "enum": [
                  "claude-mem",
                  "context7",
                  "sequential-thinking",
                  "chrome-devtools-mcp",
                  "ui-ux-pro-max",
                  "pua",
                  "curdx-flow"
                ]
              },
              "provisioning": {
                "type": "string",
                "enum": ["plugin-dependency", "external-mcp", "workflow"]
              },
              "curdxRole": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["recommend", "gate", "record-evidence", "compile-brief", "route"]
                }
              },
              "doNotReimplement": {
                "type": "boolean"
              },
              "expectedByDefault": {
                "type": "boolean"
              },
              "missingAction": {
                "type": "string"
              },
              "reason": { "type": "string" },
              "instruction": { "type": "string" },
              "triggerReason": { "type": "string" },
              "requiredWhen": { "type": "string" },
              "fallbackWhenMissing": { "type": "string" },
              "stackIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["id", "name", "type", "invocation", "phase", "availability", "reason", "instruction"],
            "additionalProperties": false
          }
        },
        "lastMile": {
          "type": "object",
          "description": "Compact last-mile autopilot state: current phase/problem, capability plan, and evidence gates inferred from route, snapshot, and project brain.",
          "additionalProperties": true
        },
        "completed": {
          "type": "boolean",
          "default": false,
          "description": "True when ALL_TASKS_COMPLETE; replaces v7.0.x file-deletion semantics"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp set when completed transitions to true (e.g. 2026-05-04T13:00:00.000Z)"
        }
      }
    },

    "epicState": {
      "type": "object",
      "description": "State for epic (multi-spec) tracking",
      "required": ["name", "goal", "specs"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Epic name in kebab-case"
        },
        "goal": {
          "type": "string",
          "description": "High-level epic goal"
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "dependencies"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "Spec name in kebab-case"
              },
              "status": {
                "type": "string",
                "enum": ["pending", "in_progress", "completed", "cancelled"],
                "description": "Spec completion status within the epic"
              },
              "dependencies": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "description": "Names of specs that must complete before this one"
              }
            }
          },
          "description": "Ordered list of specs in this epic with dependency graph"
        },
        "output": {
          "type": "string",
          "enum": ["spec-files", "github-issues", "both"],
          "description": "Where the epic plan was stored"
        },
        "issueNumber": {
          "type": ["integer", "null"],
          "description": "GitHub parent issue number (if output includes github-issues)"
        }
      }
    },

    "task": {
      "type": "object",
      "description": "Individual task structure in tasks.md. PROGRESS-TRACKING CONTRACT: each task MUST be authored as a top-level list-item with a checkbox followed immediately by a recognized task-id token, e.g. `- [ ] 1.1 …`, `- [x] 1.2 [P] …`, `- [ ] V1 [VERIFY] …`, `- [ ] VE1 [VERIFY] …`, `- [ ] VF [VERIFY] …`. Recognized id tokens: `\\d+\\.\\d+`, `V\\d+`, `VE\\d+`, `VF`. The hook `update-spec-index.mjs` parses tasks.md with `^[-*]\\s+\\[([ xX])\\]\\s+(?:\\d+\\.\\d+|V\\d+|VE\\d+|VF)(?:\\s|$)` and ignores everything else (including `### Task X.Y: … [x]` headlines). Reserved id prefixes that MUST NOT appear after a `- [ ]` / `- [x]` checkbox: `AC-`, `FR-`, `NFR-`, `US-` — those are reference identifiers, not units of work; embedding them as `- [ ] AC-1.1` collides with the tracker (real-world breakage: test003/specs/helloworld May 2026 reported 0/10 for a completed 4-task spec). Inside task bodies, render AC/FR/NFR/US enumerations as plain bullets (`- AC-1.1 — …`) or numbered lists.",
      "required": ["id", "do", "files", "done_when", "verify"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "Task ID in Phase.Task format (e.g., 1.2)"
        },
        "do": {
          "type": "string",
          "description": "Exact implementation steps"
        },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "File paths to create or modify"
        },
        "done_when": {
          "type": "string",
          "description": "Explicit success criteria"
        },
        "verify": {
          "type": "string",
          "description": "Command to verify completion"
        },
        "commit": {
          "type": "string",
          "description": "Conventional commit message"
        },
        "requirements_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced requirement IDs"
        },
        "design_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced design sections"
        }
      }
    },

    "researchFrontmatter": {
      "type": "object",
      "properties": {
        "spec": { "type": "string" },
        "phase": { "const": "research" },
        "created": { "type": "string", "format": "date-time" }
      }
    },

    "requirementsFrontmatter": {
      "type": "object",
      "properties": {
        "spec": { "type": "string" },
        "phase": { "const": "requirements" },
        "created": { "type": "string", "format": "date-time" }
      }
    },

    "designFrontmatter": {
      "type": "object",
      "properties": {
        "spec": { "type": "string" },
        "phase": { "const": "design" },
        "created": { "type": "string", "format": "date-time" }
      }
    },

    "tasksFrontmatter": {
      "type": "object",
      "properties": {
        "spec": { "type": "string" },
        "phase": { "const": "tasks" },
        "total_tasks": { "type": "integer" },
        "created": { "type": "string", "format": "date-time" }
      }
    },

    "progressFrontmatter": {
      "type": "object",
      "properties": {
        "spec": { "type": "string" },
        "phase": { "type": "string" },
        "task": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
        "updated": { "type": "string", "format": "date-time" }
      }
    },

    "indexState": {
      "type": "object",
      "description": "State for codebase indexing tracking",
      "properties": {
        "indexed": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last indexing run"
        },
        "componentCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of component specs generated"
        },
        "externalCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of external resource specs generated"
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Patterns excluded during indexing"
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths that were indexed"
        },
        "categories": {
          "type": "object",
          "description": "Component counts by category",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },

    "componentSpec": {
      "type": "object",
      "description": "Frontmatter for component spec files in specs/.index/components/",
      "required": ["type", "generated", "source", "hash", "category", "indexed"],
      "properties": {
        "type": {
          "type": "string",
          "const": "component-spec",
          "description": "Spec type identifier"
        },
        "generated": {
          "type": "boolean",
          "const": true,
          "description": "Indicates auto-generated spec"
        },
        "source": {
          "type": "string",
          "description": "Source file path relative to repo root"
        },
        "hash": {
          "type": "string",
          "description": "Content hash for change detection"
        },
        "category": {
          "type": "string",
          "enum": ["controllers", "services", "models", "helpers", "migrations", "other"],
          "description": "Component category"
        },
        "indexed": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when indexed"
        }
      }
    },

    "externalSpec": {
      "type": "object",
      "description": "Frontmatter for external resource spec files in specs/.index/external/",
      "required": ["type", "generated", "source-type", "source-id", "fetched"],
      "properties": {
        "type": {
          "type": "string",
          "const": "external-spec",
          "description": "Spec type identifier"
        },
        "generated": {
          "type": "boolean",
          "const": true,
          "description": "Indicates auto-generated spec"
        },
        "source-type": {
          "type": "string",
          "enum": ["url", "mcp", "skill"],
          "description": "Type of external resource"
        },
        "source-id": {
          "type": "string",
          "description": "URL, MCP server name, or skill identifier"
        },
        "fetched": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when resource was fetched"
        }
      }
    }
  }
}
