{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/hook-gate",
  "title": "curdx-flow Hook Gate Output",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventName",
    "runId",
    "goalId",
    "decision",
    "reason",
    "missingEvidence",
    "nextAction",
    "failOpen",
    "diagnostics"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "eventName": {
      "type": "string",
      "enum": [
        "UserPromptSubmit",
        "UserPromptExpansion",
        "PreToolUse",
        "PostToolBatch",
        "SessionStart",
        "SubagentStart",
        "SubagentStop",
        "TaskCompleted",
        "PostCompact",
        "Stop",
        "StopFailure"
      ]
    },
    "runId": { "type": "string", "minLength": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["allow", "block", "context", "fail-open"] },
    "reason": { "type": "string" },
    "missingEvidence": {
      "type": "array",
      "items": {}
    },
    "nextAction": { "type": "object", "additionalProperties": true },
    "failOpen": { "type": "boolean" },
    "diagnostics": {
      "type": "array",
      "items": {}
    }
  }
}
