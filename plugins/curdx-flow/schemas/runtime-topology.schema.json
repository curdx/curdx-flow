{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/runtime-topology",
  "title": "curdx-flow Runtime Topology",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceRoot",
    "generatedAt",
    "overallType",
    "status",
    "confidence",
    "packageManager",
    "roots",
    "pluginRoots",
    "blockers",
    "hints"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "overallType": { "$ref": "#/$defs/projectType" },
    "status": { "$ref": "#/$defs/status" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "packageManager": { "$ref": "#/$defs/packageManager" },
    "roots": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectRoot" }
    },
    "pluginRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/pluginRoot" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "hints": {
      "type": "array",
      "items": { "$ref": "#/$defs/hint" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.(?:[\\\\/]|$))(?!.*\\u0000).+)$"
    },
    "projectType": {
      "type": "string",
      "enum": ["frontend", "backend", "full-stack", "cli", "library", "monorepo", "claude-code-plugin", "unknown"]
    },
    "status": {
      "type": "string",
      "enum": ["ready", "needs-human-input", "blocked"]
    },
    "packageManager": {
      "type": "string",
      "enum": ["npm", "pnpm", "yarn", "bun", "unknown"]
    },
    "hint": {
      "type": "object",
      "required": ["kind", "source", "summary", "confidence"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["entry", "script", "service", "api", "data", "browser", "test", "validation", "plugin"]
        },
        "source": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "scriptName": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "required": ["code", "path", "severity", "summary"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "severity": { "type": "string", "enum": ["blocked", "needs-human-input"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "projectRoot": {
      "type": "object",
      "required": [
        "path",
        "type",
        "status",
        "confidence",
        "packageManager",
        "packageJsonPath",
        "scripts",
        "entryHints",
        "scriptHints",
        "serviceHints",
        "apiHints",
        "dataHints",
        "browserHints",
        "validationHints",
        "pluginHints",
        "blockers",
        "reasons"
      ],
      "additionalProperties": true,
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "type": { "$ref": "#/$defs/projectType" },
        "status": { "$ref": "#/$defs/status" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "packageManager": { "$ref": "#/$defs/packageManager" },
        "packageJsonPath": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "scripts": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "entryHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "scriptHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "serviceHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "apiHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "dataHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "browserHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "validationHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "pluginHints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pluginRoot": {
      "type": "object",
      "required": [
        "path",
        "manifestPath",
        "hooksPath",
        "skillsPath",
        "agentsPath",
        "binPaths",
        "validationCommand",
        "wiring"
      ],
      "additionalProperties": true,
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "manifestPath": { "$ref": "#/$defs/relativePath" },
        "hooksPath": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "skillsPath": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "agentsPath": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "binPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "validationCommand": {
          "type": "object",
          "required": ["executable", "argv", "cwd"],
          "additionalProperties": true,
          "properties": {
            "executable": { "type": "string", "const": "claude" },
            "argv": {
              "type": "array",
              "prefixItems": [
                { "type": "string", "const": "plugin" },
                { "type": "string", "const": "validate" },
                { "$ref": "#/$defs/relativePath" }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "cwd": { "type": "string", "const": "." }
          }
        },
        "wiring": {
          "type": "object",
          "required": ["manifest", "hooks", "skills", "agents", "bin"],
          "additionalProperties": true,
          "properties": {
            "manifest": { "type": "boolean", "const": true },
            "hooks": { "type": "boolean" },
            "skills": { "type": "boolean" },
            "agents": { "type": "boolean" },
            "bin": { "type": "boolean" }
          }
        }
      }
    }
  }
}
