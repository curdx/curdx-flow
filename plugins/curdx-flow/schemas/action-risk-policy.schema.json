{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/action-risk-policy",
  "title": "curdx-flow Action Risk Policy",
  "type": "object",
  "required": [
    "schemaVersion",
    "policyId",
    "mode",
    "defaultRiskLevel",
    "rules",
    "noFalseCompletion"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["report-only", "fix", "release"] },
    "defaultRiskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "allowedWriteRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportOnlyWriteRoot" }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "authorized": { "type": "boolean" },
        "authorizedBy": { "type": "string", "minLength": 1 },
        "authorizedAt": { "type": "string", "format": "date-time" },
        "releaseStageAuthorized": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionRiskRule" }
    },
    "noFalseCompletion": { "type": "boolean", "const": true }
  },
  "$defs": {
    "workspaceRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.(?:[\\\\/]|$))(?!.*\\u0000).+"
    },
    "reportOnlyWriteRoot": {
      "type": "string",
      "enum": [
        ".curdx/reports",
        ".curdx/evidence",
        ".curdx/artifacts",
        ".curdx/state"
      ]
    },
    "actionRiskRule": {
      "type": "object",
      "required": [
        "id",
        "riskLevel",
        "mutatesWorkspace",
        "destructive",
        "requiresAuthorization",
        "allowedModes"
      ],
      "anyOf": [
        {
          "required": ["actionType"],
          "properties": {
            "actionType": {}
          }
        },
        {
          "required": ["actionPattern"],
          "properties": {
            "actionPattern": {}
          }
        }
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actionType": {
          "type": "string",
          "enum": [
            "read",
            "command",
            "verification-rerun",
            "browser-check",
            "api-check",
            "log-read",
            "report-write",
            "evidence-write",
            "artifact-write",
            "state-write",
            "source-edit",
            "generated-verification-file",
            "config-edit",
            "dependency-install",
            "database-migration",
            "destructive-migration",
            "delete-file",
            "global-config-change",
            "git-push",
            "git-tag",
            "npm-publish",
            "plugin-release",
            "production-data-access",
            "release"
          ]
        },
        "actionPattern": { "type": "string", "minLength": 1 },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "mutatesWorkspace": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "requiresAuthorization": { "type": "boolean" },
        "allowedModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["report-only", "fix", "release"] }
        },
        "requiresReleaseStage": { "type": "boolean" },
        "allowedWriteRoots": {
          "type": "array",
          "items": { "$ref": "#/$defs/reportOnlyWriteRoot" }
        }
      }
    }
  }
}
