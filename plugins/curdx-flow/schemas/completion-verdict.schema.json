{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/completion-verdict",
  "title": "curdx-flow Completion Verdict",
  "type": "object",
  "required": [
    "schemaVersion",
    "verdict",
    "why",
    "evidenceRefs",
    "missingEvidence",
    "nextAction",
    "owner",
    "riskLevel",
    "confidence",
    "unverifiedScope"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "verdict": {
      "type": "string",
      "enum": ["complete", "blocked", "partial", "manual-confirmation-required", "release-ready"]
    },
    "why": { "type": "string", "minLength": 1 },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missingEvidence": {
      "type": "array",
      "items": {}
    },
    "nextAction": { "type": "object", "additionalProperties": true },
    "owner": { "type": "string", "minLength": 1 },
    "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "unverifiedScope": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}
