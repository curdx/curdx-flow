{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/release-verdict",
  "title": "curdx-flow Release Verdict",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "goalId",
    "generatedAt",
    "verdict",
    "version",
    "npmTag",
    "claudePluginTag",
    "checks",
    "missingEvidence",
    "blockers",
    "nextAction",
    "riskLevel",
    "trustLevel",
    "freshness",
    "sideEffects",
    "published",
    "publicationState",
    "summary"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "verdict": { "type": "string", "enum": ["release-ready", "not-releasable"] },
    "version": { "type": "string", "minLength": 1 },
    "npmTag": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
    "claudePluginTag": { "type": "string", "pattern": "^curdx-flow--v\\d+\\.\\d+\\.\\d+" },
    "checks": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "missingEvidence": {
      "type": "array",
      "items": {}
    },
    "blockers": {
      "type": "array",
      "items": {}
    },
    "nextAction": { "type": "object", "additionalProperties": true },
    "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "trustLevel": { "type": "string", "enum": ["L4", "release"] },
    "freshness": {
      "type": "object",
      "required": ["ok", "reasons", "context"],
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "context": {
          "type": "object",
          "required": ["currentCommit", "version", "npmTag", "claudePluginTag", "generatedAt", "evidenceRefs"],
          "additionalProperties": true,
          "properties": {
            "currentCommit": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "npmTag": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
            "claudePluginTag": { "type": "string", "pattern": "^curdx-flow--v\\d+\\.\\d+\\.\\d+" },
            "generatedAt": { "type": "string", "format": "date-time" },
            "evidenceRefs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "sideEffects": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "published": { "type": "boolean", "const": false },
    "publicationState": { "type": "string", "enum": ["not-published"] },
    "summary": {
      "type": "object",
      "required": ["headline", "publicationState", "statusLabel", "dryRunOnly"],
      "additionalProperties": true,
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "publicationState": { "type": "string", "enum": ["not-published"] },
        "statusLabel": { "type": "string", "enum": ["可发布", "不可发布"] },
        "dryRunOnly": { "type": "boolean", "const": true }
      }
    }
  }
}
