{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/verification-report",
  "title": "curdx-flow Verification Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "goalId",
    "status",
    "verdict",
    "summary",
    "evidenceRefs",
    "artifactIndex",
    "blockers",
    "missingEvidence",
    "generatedAt",
    "privacy",
    "transcriptSummary",
    "evidenceSummaries",
    "artifactSummaries",
    "sections",
    "sourceChanges",
    "reportOnly",
    "verifier"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "auto-recovered",
        "needs-user-input",
        "partial",
        "release-ready",
        "not-releasable"
      ]
    },
    "verdict": {
      "type": "object",
      "required": [
        "schemaVersion",
        "verdict",
        "why",
        "evidenceRefs",
        "missingEvidence",
        "nextAction",
        "owner",
        "riskLevel",
        "confidence",
        "unverifiedScope"
      ],
      "additionalProperties": true,
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "verdict": {
          "type": "string",
          "enum": ["complete", "blocked", "partial", "manual-confirmation-required", "release-ready"]
        },
        "why": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missingEvidence": {
          "type": "array",
          "items": {}
        },
        "nextAction": { "type": "object", "additionalProperties": true },
        "owner": { "type": "string", "minLength": 1 },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "unverifiedScope": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifactIndex": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactSummary" }
    },
    "blockers": {
      "type": "array",
      "items": {}
    },
    "missingEvidence": {
      "type": "array",
      "items": {}
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "privacy": {
      "type": "object",
      "required": ["classification", "containsSensitiveData", "redacted", "truncated"],
      "additionalProperties": true,
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "secret", "local-only"]
        },
        "containsSensitiveData": { "type": "boolean" },
        "redacted": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "transcriptSummary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "evidenceSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceSummary" }
    },
    "artifactSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactSummary" }
    },
    "sections": {
      "type": "object",
      "required": [
        "blockers",
        "missingEvidence",
        "manualConfirmation",
        "nextActions",
        "degradedCapabilities",
        "unverifiedScope"
      ],
      "additionalProperties": true,
      "properties": {
        "blockers": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "missingEvidence": {
          "type": "array",
          "items": {}
        },
        "manualConfirmation": {
          "type": "array",
          "items": {}
        },
        "nextActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nextAction" }
        },
        "degradedCapabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/degradedCapability" }
        },
        "unverifiedScope": {
          "type": "array",
          "items": {}
        }
      }
    },
    "sourceChanges": {
      "type": "object",
      "required": ["modifiedSource", "summary", "files"],
      "additionalProperties": true,
      "properties": {
        "modifiedSource": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.(?:[\\\\/]|$))(?!.*\\u0000).+"
          }
        }
      }
    },
    "reportOnly": { "type": "boolean" },
    "verifier": {
      "type": "object",
      "required": ["command", "exitCode"],
      "additionalProperties": true,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exitCode": {
          "type": ["integer", "null"]
        }
      }
    }
  },
  "$defs": {
    "evidenceSummary": {
      "type": "object",
      "required": [
        "id",
        "source",
        "capabilityId",
        "status",
        "trustLevel",
        "summary",
        "artifactRefs",
        "freshness",
        "unverifiedScope"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "enum": ["command", "service", "browser", "api", "data", "log", "manual", "release", "hook"]
        },
        "capabilityId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "blocked", "degraded", "skipped"]
        },
        "trustLevel": {
          "type": "string",
          "enum": ["verified", "self-reported", "degraded", "manual-confirmed"]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "artifactRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "freshness": { "type": "string", "minLength": 1, "maxLength": 240 },
        "unverifiedScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "degradedReason": { "type": "string", "maxLength": 240 }
      }
    },
    "artifactSummary": {
      "type": "object",
      "required": ["id", "evidenceId", "type", "path", "summary", "privacy"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["screenshot", "trace", "log", "request", "response", "report", "state", "other"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.(?:[\\\\/]|$))(?!.*\\u0000).+"
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "privacy": {
          "type": "object",
          "required": ["classification", "containsSensitiveData", "redacted"],
          "additionalProperties": true,
          "properties": {
            "classification": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "secret", "local-only"]
            },
            "containsSensitiveData": { "type": "boolean" },
            "redacted": { "type": "boolean" }
          }
        }
      }
    },
    "nextAction": {
      "type": "object",
      "required": ["owner", "summary", "riskLevel"],
      "additionalProperties": true,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "degradedCapability": {
      "type": "object",
      "required": ["capabilityId", "source", "evidenceId", "reason"],
      "additionalProperties": true,
      "properties": {
        "capabilityId": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "enum": ["command", "service", "browser", "api", "data", "log", "manual", "release", "hook"]
        },
        "evidenceId": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
