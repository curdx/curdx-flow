{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curdx-flow/evidence",
  "title": "curdx-flow Evidence Block",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "goalId",
    "source",
    "capabilityId",
    "trustLevel",
    "status",
    "summary",
    "artifacts",
    "startedAt",
    "completedAt",
    "freshness",
    "privacy",
    "redactions"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "enum": ["command", "service", "browser", "api", "data", "log", "manual", "release", "hook"]
    },
    "capabilityId": { "type": "string", "minLength": 1 },
    "trustLevel": {
      "type": "string",
      "enum": ["verified", "self-reported", "degraded", "manual-confirmed"]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "degraded", "skipped"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "freshness": {
      "type": "object",
      "required": ["validatedAt"],
      "minProperties": 2,
      "anyOf": [
        {
          "required": ["commandHash"],
          "properties": { "commandHash": { "type": "string", "minLength": 1 } }
        },
        {
          "required": ["targetHash"],
          "properties": { "targetHash": { "type": "string", "minLength": 1 } }
        },
        {
          "required": ["fileTargets"],
          "properties": {
            "fileTargets": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          }
        },
        {
          "required": ["environmentId"],
          "properties": { "environmentId": { "type": "string", "minLength": 1 } }
        },
        {
          "required": ["targetSummary"],
          "properties": { "targetSummary": { "type": "string", "minLength": 1 } }
        }
      ],
      "additionalProperties": true,
      "properties": {
        "validatedAt": { "type": "string", "format": "date-time" },
        "commandHash": { "type": "string", "minLength": 1 },
        "targetHash": { "type": "string", "minLength": 1 },
        "fileTargets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "environmentId": { "type": "string", "minLength": 1 },
        "targetSummary": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "privacy": { "type": "object", "additionalProperties": true },
    "redactions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "relatedEvidenceIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": { "type": "string" },
    "unverifiedScope": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
