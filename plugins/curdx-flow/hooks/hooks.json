{
  "description": "curdx-flow hooks for spec execution validation, session context loading, and quick mode enforcement",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "curdx-flow:.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/user-prompt-expansion-guard.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking curdx-flow slash context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/quick-mode-guard.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking quick-mode question policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-watcher.mjs\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Checking curdx-flow execution state"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/load-spec-context.mjs\"",
            "shell": "bash",
            "timeout": 15,
            "async": true,
            "statusMessage": "Loading active spec context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-context-injector.mjs\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Preparing subagent spec context"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-completed-verifier.mjs\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Verifying completed task evidence"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-tool-batch-snapshot.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking curdx-flow batch state"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-failure-handler.mjs\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Recording stop failure context"
          }
        ]
      }
    ]
  }
}
